# --- Hugo 构建产物 ---
# 由 `hugo` / `hugo server` 生成，不要提交
/public/
/resources/
.hugo_build.lock

# --- Node 相关（Blowfish 只在你需要改主题模板、重编译 Tailwind 时才用得到）---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# --- 部署平台 ---
.netlify/
.vercel/
.firebase/
functions/node_modules/

# --- 密钥与本地环境变量 ---
.env
.env.*
!.env.example
.credentials.yaml
.webui_secret_key
*.pem

# --- 编辑器与 IDE ---
.idea/
*.iml
.vscode/
*.code-workspace
*.swp

# --- 操作系统 ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# --- 主题子模块的构建产物与依赖 ---
# 注意：themes/blowfish 是 git submodule，只忽略它内部的产物，绝不忽略主题本身
themes/blowfish/public/
themes/blowfish/resources/
themes/blowfish/exampleSite/public/
themes/blowfish/exampleSite/resources/
themes/blowfish/node_modules/
themes/blowfish/.hugo_build.lock

# --- 本地临时目录（不属于站点内容）---
/.tmp/
/scratch/

# --- 本地项目约定 ---
/AGENTS.md

# --- 本地维护文档 ---
/docs/
